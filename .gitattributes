# Normalise to LF in the repository; Git checks out CRLF on Windows.
* text=auto eol=lf

# Windows-native files stay CRLF in the working tree.
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.manifest  text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

*.png binary
*.ico binary
